# -----------------------------
# Application
# -----------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# -----------------------------
# Mistral - supervisor/tool calling
# -----------------------------
MISTRAL_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# -----------------------------
# Google - embeddings for Chroma RAG
# -----------------------------
GOOGLE_API_KEY=
EMBEDDING_MODEL=models/gemini-embedding-2
COLLECTION_NAME=industrial_manuals

# -----------------------------
# Sarvam - speech to text + translation
# -----------------------------
SARVAM_API_KEY=
SARVAM_STT_TRANSLATE_URL=
SARVAM_STT_MODEL=saaras:v2.5
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=aditya
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_PIECE_SECONDS=25
AUDIO_CHUNK_MINUTES=10

# -----------------------------
# Twilio - technician alert
# -----------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TECHNICIAN_PHONE_NUMBER=
TWILIO_TRIAL_MODE=true
TWILIO_TRIAL_VERIFIED_NUMBER=
PUBLIC_BACKEND_URL=https://your-public-domain.example.com
TWILIO_CALL_URL=

# -----------------------------
# RAG chunking
# -----------------------------
CHUNK_SIZE_GENERAL=800
CHUNK_OVERLAP_GENERAL=150
CHUNK_SIZE_OEM=600
CHUNK_OVERLAP_OEM=100
RAG_TOP_K=5
